        "Left Shoulder Down-Up": -0.62, "Right Shoulder Down-Up": -0.58,
        "Left Arm Down-Up": -0.03, "Right Arm Down-Up": -0.08,
        "Left Arm Front-Back": -0.19, "Right Arm Front-Back": -0.14, "Left Arm Twist In-Out": 0.02, "Right Arm Twist In-Out": -0.05,
        "Left Forearm Stretch": -0.02, "Right Forearm Stretch": -0.1,
        "Left Hand Down-Up": -0.15, "Right Hand Down-Up": -0.15, "Left Hand In-Out": 0, "Right Hand In-Out": 0
      },
      "fingers": { "both": { "joints": [0.46, 0.4, 0.3], "spread": 0.0 }, "left.thumb": { "curl": 0.2, "spread": 0.1 }, "right.thumb": { "curl": 0.2, "spread": 0.1 } }
