  "cycles": [
    // breath, 4 s (15 a minute): chest opens, shoulders and arms lift a touch, the head answers
    { "period": 4, "phase": 0, "muscles": { "Chest Front-Back": 0.03, "UpperChest Front-Back": 0.02, "Left Shoulder Down-Up": 0.05, "Right Shoulder Down-Up": 0.05, "Left Arm Down-Up": 0.015, "Right Arm Down-Up": 0.015, "Neck Nod Down-Up": -0.01 }, "root": { "pos": [0, 0.004, 0] } },
