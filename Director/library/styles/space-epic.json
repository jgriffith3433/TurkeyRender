  "grade": {
    "exposure": -0.05, "contrast": 20, "saturation": 16, "hue": 0, "vignette": 0.3, "grain": 0.04, "bloom": 0.45, "threshold": 1.05, "chroma": 0.01,
    "split": 0.16, "splitA": "#172a6a", "splitB": "#ffe6bf", "lift": 0, "halation": 0.12, "haze": 0, "veil": 0.25, "dust": 0, "curve": 0.3, "skin": 0.4, "sunRim": 1.4, "faceFill": 0.22, "catch": 1
  },
  "lens": { "close-up": 85, "medium": 50, "wide": 24, "over-shoulder": 60, "two-shot": 40, "tracking": 32, "apertureScale": 1.3 },
  "type": { "color": "#dfe8ff", "style": "fade", "size": 58, "pos": [0.5, 0.14, 0], "in": 0.3, "out": 0.3 },
  "cues": [ { "at": 0, "light": "key", "intensity": 0 } ]
