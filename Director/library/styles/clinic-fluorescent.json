{
  // Hawkes Punch's clinic: pale green and white under fluorescent panels, flat and a little too bright. Low contrast, a touch of lift so the blacks go grey-green, no halation,
  // no haze. The lens is a modest documentary 40; nothing dreamy. The only red in the room is the poster and the can, so saturation stays down and lets them shout.
  // The base look of the whole video (videos/hawkespunch/style.json): the space and commercial sections move it with their moods (library/moods.json: space_*, tv_*).
  "about": "A clinic under fluorescent light: pale green and white, flat, slightly too bright. Waiting rooms, offices, anything that should feel sick and small.",
  "light": "clinic_fluorescent",
  "grade": {
    "exposure": 0.2, "contrast": -4, "saturation": -8, "hue": 0, "vignette": 0.05, "grain": 0.03, "bloom": 0.22, "threshold": 1.0, "chroma": 0,
    "split": 0.08, "splitA": "#9fb6a8", "splitB": "#f6f3e4", "lift": 0.02, "halation": 0, "haze": 0, "veil": 0, "dust": 0, "curve": 0.2, "skin": 0.3, "sunRim": 0, "faceFill": 0.5, "catch": 1
  },
  "lens": { "close-up": 65, "medium": 40, "wide": 26, "over-shoulder": 50, "two-shot": 35, "tracking": 32, "apertureScale": 1.1 },
  "type": { "color": "#1e3b2f", "style": "fade", "size": 54, "pos": [0.5, 0.14, 0], "in": 0.25, "out": 0.25 },
  "cues": [ { "at": 0, "light": "key", "intensity": 0 } ]
}
