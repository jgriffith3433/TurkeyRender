{
 "name": "bolt_away",
 "about": "The getaway: a coil (crouch, with anticipation) and then the whole body shoots into the superman (arms over the head, legs together) with overshoot. The flight across the sky is the card's; this is the body. A grin. No ground. Ends in fly_fast's pose. Plays `base` (IdleBreathe) under it from the start, so the take has a clip of its own and nothing adds up when it is baked or played alone (base 0 leaves what plays underneath).",
 "entry": "fly",
 "exit": "fly",
 "length": "1.1s",
 "min": "0.8s",
 "params": {
  "base": "IdleBreathe",
  "baseBlend": 0.3
 },
 "cues": [
  {
   "at": 0,
   "do": "anim",
   "clip": "$base",
   "blend": "$baseBlend",
   "if": "$base"
  },
  {
   "at": 0,
   "do": "ground",
   "amount": 0,
   "for": "0.1s"
  },
  {
   "at": 0,
   "do": "face",
   "smile": 0.9,
   "eyesWide": 0.4,
   "for": "0.15s",
   "ease": "out"
  },
  {
   "at": 0,
   "do": "keys",
   "anticipate": 0.1,
   "successive": 0.03,
   "keys": [
    {
     "t": 0.22,
     "ease": "in",
     "hold": 0.06,
     "pose": "crouch",
     "bones": {
      "head": [
       -10,
       0,
       0
      ]
     }
    },
    {
     "t": 0.5,
     "ease": "out",
     "overshoot": 0.12,
     "settle": "0.35s",
     "from": "mx_hanging_idle@1.0",
     "bones": {
      "head": [
       -18,
       0,
       0
      ],
      "chest": [
       -6,
       0,
       0
      ]
     }
    }
   ],
   "release": "0.6s"
  },
  {
   "at": 0.3,
   "do": "fingers",
   "hand": "left",
   "set": 0.9,
   "for": "0.2s"
  },
  {
   "at": 0.3,
   "do": "fingers",
   "hand": "right",
   "set": 0.9,
   "for": "0.2s"
  }
 ],
 "test": {
