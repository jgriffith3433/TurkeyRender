   "once": 1,
   "weight": "$weight",
   "for": "=for-0.3",
   "blend": "0.15s"
  },
  {
   "at": 0.15,
   "do": "fingers",
   "hand": "right",
   "set": 0.85,
   "for": 0.15
  },
  {
   "at": 0.15,
   "do": "fingers",
   "hand": "right",
   "finger": "index",
   "set": 0.03,
   "for": 0.15
  },
  {
   "at": "=for-0.35",
   "do": "fingers",
   "hand": "right",
   "set": 0.3,
   "for": 0.3
  },
  {
   "at": "=for-0.35",
   "do": "fingers",
   "hand": "right",
   "finger": "index",
   "set": 0.3,
   "for": 0.3
  }
 ],
 "test": {
