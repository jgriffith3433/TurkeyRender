{
 "name": "stand",
 "about": "The default stand, rebuilt: arms hang close with a soft bend, hands open and relaxed, weight on his left leg, a small breathing sway. It sets a `stance` that holds through every later performance until one turns it off, so everything standing inherits it. `settle` is how long it takes to come in; 0.01 on a cut.",
 "entry": "any",
 "exit": "stand",
 "length": "3s",
 "min": "0.5s",
 "params": {
  "blend": 0.5,
  "settle": 0.5,
  "side": -1
 },
 "cues": [
  {
   "at": 0,
   "do": "anim",
   "clip": "IdleBreathe",
   "blend": "$blend"
  },
  {
   "at": 0,
   "do": "stance",
   "arms": 1,
   "legs": 1,
   "shift": "=side*0.025",
   "narrow": 0.05,
   "drop": 0.012,
   "tilt": "=side*-2",
   "sway": 0.008,
   "period": 5.2,
   "bones": {
    "leftUpperArm": [
     -3,
     0,
     15
    ],
    "rightUpperArm": [
     -3,
     0,
     -15
    ],
    "leftLowerArm": [
     12,
     0,
     -20
    ],
    "rightLowerArm": [
     12,
     0,
     20
    ],
    "leftHand": [
     6,
     18,
     18
    ],
    "rightHand": [
     6,
     -18,
     -18
    ]
   },
   "for": "$settle",
   "ease": "inout"
  },
  {
   "at": 0,
   "do": "fingers",
   "hand": "left",
   "set": 0.35,
   "for": "$settle",
   "ease": "inout"
  },
  {
   "at": 0,
   "do": "fingers",
   "hand": "right",
   "set": 0.35,
   "for": "$settle",
   "ease": "inout"
  },
  {
   "at": "=for*0.4",
   "do": "blink",
   "for": "0.2s"
  }
 ],
 "test": {
  "tail": 0.2
 }
}
