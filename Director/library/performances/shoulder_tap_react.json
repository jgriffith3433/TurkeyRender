{
 "name": "shoulder_tap_react",
 "about": "A tap on the shoulder in space: the shoulders jump, the eyes flick to `side` (1 his right, -1 his left), the head turns over that shoulder and the body follows, hands half up. Eyes wide, then the jaw drops on seeing him. No ground. Ends flying, turned. Plays `base` (IdleBreathe) under it from the start, so the take has a clip of its own and nothing adds up when it is baked or played alone (base 0 leaves what plays underneath).",
 "entry": "fly",
 "exit": "fly",
 "length": "1.9s",
 "min": "1.4s",
 "params": {
  "base": "IdleBreathe",
  "baseBlend": 0.3,
  "side": 1
 },
