   "do": "ground",
   "amount": 0,
   "for": "0.1s"
  },
  {
   "at": 0,
   "do": "gaze",
   "toRel": [
    "=side*2.5",
    1.6,
    -0.6
   ],
   "for": "0.12s",
   "head": 0,
   "ease": "out"
  },
  {
   "at": 0.02,
   "do": "face",
