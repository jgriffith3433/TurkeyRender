  // Hawkes Punch's space (Assets/MusicVideo/Props/Punch; punch_tex.py paints the planets and the stars). Origin 300 m up and 1500 m out so nothing else is in the sky.
  // A star sphere of radius 1400 (its own stars, painted, no twinkle: the sky cue keeps `stars` at 0), a sun ball far off at +x -z and high, with the directional
  // `sun` of lighting/space_sun.json coming from the same place, so every planet and body is lit hard from one side and rimmed from behind.
  // Heading 0 at `start` looks at +z: the Earth is behind him and down (-z), the Moon ahead and right, the asteroid field ahead, the comet further, Mars left, Saturn far left, Jupiter far right.
  // Every planet is an actor with its pivot at its centre, so `move`, `scale`, `rotate`, `spin`, `jump` and the rope work on it as it is. Scales: a prim sphere is 1 m across, so `scale` is the diameter;
  // the moon, comet, asteroids and satellite are built at radius 1, so `scale` is the radius. Saturn's ring is parented to Saturn and tilted.
  // Marks are where each stunt starts; a card moves the planets from there. Small turkeys stand on the Moon's crater rim and on Mars (unparented: attach them when the planet is thrown).
  "origin": [0, 300, 1500],
  "bounds": [-650, -650, 650, 650],
  "ceiling": 1400,
  "light": "space_sun",
  "solids": {},
  "models": {
    "star_dome": "Assets/MusicVideo/Props/Punch/star_dome.fbx", "moon": "Assets/MusicVideo/Props/Punch/moon.fbx", "saturn_ring": "Assets/MusicVideo/Props/Punch/saturn_ring.fbx",
