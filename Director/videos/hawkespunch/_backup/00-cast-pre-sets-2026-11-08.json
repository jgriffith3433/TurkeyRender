{
  // Who can be cast in Hawkes Punch. Where they stand and whether they show comes from the cards (cut.json, cards/). Wardrobe: tools/punch_wardrobe.py.
  "actors": {
    // him, after Greener: the purple tee, pale and green-tinged, face and body alike (tools/punch_wardrobe.py: Person_sick + Person_sick_head)
    "person": { "model": "person", "material": "Assets/Videos/hawkespunch/Props/Person_sick.mat", "material2": "Assets/Videos/hawkespunch/Props/Person_sick_head.mat" },
    // the doctor: Person2 in a blue top under her white lab coat. The coat is a real garment on her rig (Director/tools/blender_coat.py,
    // coat_assets.py): knee length, open front, lapels, collar, pockets, a pen, the name badge on the breast pocket and the stethoscope
    // round her neck are all part of it, skinned to her bones, so they move with her, hide with her and never pop.
    "doctor": { "model": "person2", "material": "Assets/Videos/hawkespunch/Props/Person2_doctor.mat", "material2": "Assets/MusicVideo/Person2/Head.mat", "wear": [{ "model": "Assets/MusicVideo/Person2/Coat/Coat.fbx", "materials": { "Coat_Cloth": "Assets/MusicVideo/Person2/Coat/Coat_Cloth.mat", "Coat_Badge": "Assets/MusicVideo/Person2/Coat/Coat_Badge.mat", "Coat_Dark": "Assets/MusicVideo/Person2/Coat/Coat_Dark.mat", "Coat_Metal": "Assets/MusicVideo/Person2/Coat/Coat_Metal.mat", "Coat_Pen": "Assets/MusicVideo/Person2/Coat/Coat_Pen.mat" } }] },
    // the other one: the same man in the red tee
    "other": { "model": "person", "material": "Assets/Videos/hawkespunch/Props/Person_red.mat", "material2": "Assets/MusicVideo/Person/Head.mat" },
    // the turkey nurse at reception
    "nurse": { "model": "turkey_white_hero", "scale": 1.1 },
    // her glasses, on her nose: parented to her head bone (at rest Person2's Head is turned exactly as her root, measured with
    // call inspect '{"bones":["Head"]}', so the offset is plain: the bridge 9 cm over the joint and 14 cm in front). They show and hide with
    // her (withHost, cards.mjs). Taking them off: attach to doctor.leftHand (pos [0.02, -0.03, 0.06], rot [0, 0, 90]),
    // then detach where she puts them down. glasses_lens.fbx (tools/glasses_lens.py): the frame on punch.mat, clear lenses on Glasses_Lens.mat
    // (transparent, faint tint, highlight kept); no "material" key here, or it would paint the lenses opaque again.
    "doctor_glasses": { "model": "Assets/MusicVideo/Props/Punch/glasses_lens.fbx", "parent": "doctor.head", "withHost": true, "pos": [0, 0.089, 0.141], "rot": [0, 0, 0] },
    // the can he takes off the desk and carries into space; a copy for the commercial drink, and the one that rolls into frame at the end
    "can": { "model": "Assets/MusicVideo/Props/Punch/can.fbx", "material": "Assets/MusicVideo/Props/Punch/can_label.mat", "pos": [700.85, 0.755, 1.72], "rot": [0, 30, 0] },
    "can_other": { "model": "Assets/MusicVideo/Props/Punch/can.fbx", "material": "Assets/MusicVideo/Props/Punch/can_label.mat", "pos": [900.1, 0.74, 1.25], "rot": [0, -30, 0] },
    // the commercial's cans, as the video's own actors (attached to their hands; the set's can pieces stay hidden)
    "tv_can_a": { "model": "Assets/MusicVideo/Props/Punch/can.fbx", "material": "Assets/MusicVideo/Props/Punch/can_label.mat", "pos": [899.9, 0.74, 1.15] },
    "tv_can_b": { "model": "Assets/MusicVideo/Props/Punch/can.fbx", "material": "Assets/MusicVideo/Props/Punch/can_label.mat", "pos": [900.1, 0.74, 1.25] },
    // PUNCHUP #15, the space ghost: a faceless white sheet, soft glow, nobody ever notices it (s_earth, st_look)
    "space_ghost": { "model": "none", "pos": [-7, 296.8, 1485] },
    "ghost_body": { "model": "prim:capsule", "parent": "space_ghost", "pos": [0, 0, 0], "scale": [0.72, 0.75, 0.55], "color": "#f2f4ff", "emission": "#3a4060", "smooth": 0.1 },
    "ghost_arm": { "model": "prim:capsule", "parent": "space_ghost", "pos": [0.38, 0.05, 0], "rot": [0, 0, 50], "scale": [0.13, 0.24, 0.13], "color": "#f2f4ff", "emission": "#3a4060", "smooth": 0.1 },
    "ghost_arm_l": { "model": "prim:capsule", "parent": "space_ghost", "pos": [-0.38, 0.0, 0], "rot": [0, 0, -50], "scale": [0.13, 0.24, 0.13], "color": "#f2f4ff", "emission": "#3a4060", "smooth": 0.1 },
    "ghost_hem_1": { "model": "prim:sphere", "parent": "space_ghost", "pos": [-0.24, -0.66, 0], "scale": 0.24, "color": "#f2f4ff", "emission": "#3a4060", "smooth": 0.1 },
    "ghost_hem_2": { "model": "prim:sphere", "parent": "space_ghost", "pos": [-0.08, -0.72, 0], "scale": 0.24, "color": "#f2f4ff", "emission": "#3a4060", "smooth": 0.1 },
    "ghost_hem_3": { "model": "prim:sphere", "parent": "space_ghost", "pos": [0.08, -0.66, 0], "scale": 0.24, "color": "#f2f4ff", "emission": "#3a4060", "smooth": 0.1 },
    "ghost_hem_4": { "model": "prim:sphere", "parent": "space_ghost", "pos": [0.24, -0.72, 0], "scale": 0.24, "color": "#f2f4ff", "emission": "#3a4060", "smooth": 0.1 },
    // his drawing of her (a sheet of paper), and the boards over the window the next day
    "glove": { "model": "prim:sphere", "pos": [699.6, 1.5, 3.5], "scale": [0.17, 0.14, 0.21], "color": "#c0141c", "smooth": 0.55 },
    "drawing": { "model": "prim:cube", "pos": [700, 1.2, 2], "scale": [0.21, 0.28, 0.004], "texture": "Assets/Videos/hawkespunch/Props/ghost_drawing.png", "color": "#ffffff", "smooth": 0.05 },
    "window_boards": { "model": "prim:cube", "pos": [700.6, 1.55, 4.47], "scale": [1.3, 1.1, 0.03], "texture": "Assets/Videos/hawkespunch/Props/window_boards.png", "color": "#ffffff", "smooth": 0.1 },
    // draft 2: her Golden Gloves frame on the exam room's north wall, behind her desk (the bomb under the table)
    "gloves_frame": { "model": "prim:cube", "pos": [701.95, 1.7, 4.49], "scale": [0.6, 0.75, 0.02], "texture": "Assets/Videos/hawkespunch/Props/gloves_frame.png", "color": "#ffffff", "smooth": 0.15 },
    "can_roll": { "model": "Assets/MusicVideo/Props/Punch/can.fbx", "material": "Assets/MusicVideo/Props/Punch/can_label.mat", "pos": [702.5, 0.033, 0.9], "rot": [0, 0, 90] },
    // the Earth he grabs by mistake: half a metre across in his hands, then it goes back and grows to a planet
    "earth_small": { "model": "prim:sphere", "scale": 0.5, "texture": "Assets/MusicVideo/Props/Punch/tex/earth.png", "smooth": 0.35, "rot": [0, 140, 23], "pos": [-24.5, 301.25, 1650] },
    // aim points for cameras that need to look somewhere no mark is
    "aim_punch": { "model": "none", "pos": [700.6, 1.4, 3.3] },
    "aim_sky": { "model": "none", "pos": [700.6, 40, 60] },
    "aim_roof": { "model": "none", "pos": [700.6, 4.2, 4.6] },
    "aim_flick": { "model": "none", "pos": [4.15, 301.35, 1510.4] },
    "aim_volley": { "model": "none", "pos": [0, 302, 1650] },
    "aim_toss": { "model": "none", "pos": [700.9, 1.15, 3.05] },
    // the commercial's lenses, for eyes to the camera
    "aim_lens_a": { "model": "none", "pos": [900, 1.35, -3.4] },
    "aim_lens_cu_l": { "model": "none", "pos": [899.25, 1.35, -0.4] },
    "aim_lens_cu_r": { "model": "none", "pos": [900.75, 1.35, -0.4] }
  },
  "cues": [
    // person2 imports with her shape keys at 100: hold them at 0 from time zero
    { "at": 0, "do": "face", "on": "doctor", "blink": 0, "smile": 0, "jawOpen": 0, "fear": 0, "eyesWide": 0, "for": "0.01b" },
    // native: the clips' hands are splayed flat, so every hand gets a relaxed curl ON TOP of the clip (curl, not set: set freezes the fingers) (her right is left to the writing clip's pen grip)
    { "at": 0, "do": "fingers", "on": "person", "hand": "left", "curl": 0.42, "for": 0 }, { "at": 0, "do": "fingers", "on": "person", "hand": "right", "curl": 0.42, "for": 0 },
    { "at": 0, "do": "fingers", "on": "other", "hand": "left", "curl": 0.42, "for": 0 }, { "at": 0, "do": "fingers", "on": "other", "hand": "right", "curl": 0.42, "for": 0 },
    { "at": 0, "do": "fingers", "on": "doctor", "hand": "left", "curl": 0.4, "for": 0 },
    // the glasses are on from her first shot; off from the wind-up (29:3) until a card puts them back (the script's "takes off her glasses" wants
    // the attach to her hand above in place of this hide)
    { "at": "29:3", "do": "hide", "on": "doctor_glasses" },
    
    // the set's own desk can stays hidden: the card's `can` is the one that moves
    { "at": 0, "do": "hide", "on": "clinic_can_desk" }, { "at": "83:3", "do": "hide", "on": "clinic_can_desk" },
    { "at": 0, "do": "hide", "on": "can" }, { "at": 0, "do": "hide", "on": "can_other" }, { "at": 0, "do": "hide", "on": "can_roll" }, { "at": 0, "do": "hide", "on": "space_ghost" }, { "at": 0, "do": "hide", "on": "ghost_body" },  { "at": 0, "do": "hide", "on": "ghost_arm" }, { "at": 0, "do": "hide", "on": "glove" }, { "at": 0, "do": "hide", "on": "window_boards" }, { "at": 0, "do": "hide", "on": "drawing" }, { "at": 0, "do": "hide", "on": "ghost_hem_4" }, { "at": 0, "do": "hide", "on": "ghost_hem_3" }, { "at": 0, "do": "hide", "on": "ghost_hem_2" }, { "at": 0, "do": "hide", "on": "ghost_hem_1" }, { "at": 0, "do": "hide", "on": "ghost_arm_l" }, { "at": 0, "do": "hide", "on": "tv_can_a" }, { "at": 0, "do": "hide", "on": "tv_can_b" }
  ]
}
