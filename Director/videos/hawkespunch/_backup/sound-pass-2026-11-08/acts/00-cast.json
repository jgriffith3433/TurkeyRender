    "ghost_body": { "model": "prim:capsule", "parent": "space_ghost", "pos": [0, 0, 0], "scale": [0.72, 0.75, 0.55], "color": "#f2f4ff", "emission": "#3a4060", "smooth": 0.1 },
    "ghost_arm": { "model": "prim:capsule", "parent": "space_ghost", "pos": [0.38, 0.05, 0], "rot": [0, 0, 50], "scale": [0.13, 0.24, 0.13], "color": "#f2f4ff", "emission": "#3a4060", "smooth": 0.1 },
    "ghost_arm_l": { "model": "prim:capsule", "parent": "space_ghost", "pos": [-0.38, 0.0, 0], "rot": [0, 0, -50], "scale": [0.13, 0.24, 0.13], "color": "#f2f4ff", "emission": "#3a4060", "smooth": 0.1 },
    "ghost_hem_1": { "model": "prim:sphere", "parent": "space_ghost", "pos": [-0.24, -0.66, 0], "scale": 0.24, "color": "#f2f4ff", "emission": "#3a4060", "smooth": 0.1 },
    "ghost_hem_2": { "model": "prim:sphere", "parent": "space_ghost", "pos": [-0.08, -0.72, 0], "scale": 0.24, "color": "#f2f4ff", "emission": "#3a4060", "smooth": 0.1 },
    "ghost_hem_3": { "model": "prim:sphere", "parent": "space_ghost", "pos": [0.08, -0.66, 0], "scale": 0.24, "color": "#f2f4ff", "emission": "#3a4060", "smooth": 0.1 },
