  "cues": [
    // person2 imports with her shape keys at 100: hold them at 0 from time zero
    { "at": 0, "do": "face", "on": "doctor", "blink": 0, "smile": 0, "jawOpen": 0, "fear": 0, "eyesWide": 0, "for": "0.01b" },
    // native: the clips' hands are splayed flat, so every hand gets a relaxed curl ON TOP of the clip (curl, not set: set freezes the fingers) (her right is left to the writing clip's pen grip)
    { "at": 0, "do": "fingers", "on": "person", "hand": "left", "curl": 0.42, "for": 0 }, { "at": 0, "do": "fingers", "on": "person", "hand": "right", "curl": 0.42, "for": 0 },
    { "at": 0, "do": "fingers", "on": "other", "hand": "left", "curl": 0.42, "for": 0 }, { "at": 0, "do": "fingers", "on": "other", "hand": "right", "curl": 0.42, "for": 0 },
    { "at": 0, "do": "fingers", "on": "doctor", "hand": "left", "curl": 0.4, "for": 0 },
    // the glasses show while she is in the room and still: the clinic parts, off from the wind-up (21:3) to the button; the stethoscope through the exam
    { "at": 0, "do": "hide", "on": "doctor_glasses" }, { "at": "12.120s", "do": "attach", "on": "stethoscope", "to": "doctor.chest", "pos": [0, 0.16, 0.13], "rot": [0, 0, 0] }, { "at": "12.120s", "do": "attach", "on": "name_badge", "to": "doctor.chest", "pos": [0.1, 0.06, 0.135], "rot": [0, 0, 0] }, 
    { "at": "29:3", "do": "hide", "on": "doctor_glasses" },
    
    // the set's own desk can stays hidden: the card's `can` is the one that moves
    { "at": 0, "do": "hide", "on": "clinic_can_desk" }, { "at": "83:3", "do": "hide", "on": "clinic_can_desk" },
    { "at": 0, "do": "hide", "on": "can" }, { "at": 0, "do": "hide", "on": "can_other" }, { "at": 0, "do": "hide", "on": "can_roll" }, { "at": 0, "do": "hide", "on": "space_ghost" }, { "at": 0, "do": "hide", "on": "ghost_body" },  { "at": 0, "do": "hide", "on": "ghost_arm" }, { "at": 0, "do": "hide", "on": "glove" }, { "at": 0, "do": "hide", "on": "window_boards" }, { "at": 0, "do": "hide", "on": "drawing" }, { "at": 0, "do": "hide", "on": "ghost_hem_4" }, { "at": 0, "do": "hide", "on": "ghost_hem_3" }, { "at": 0, "do": "hide", "on": "ghost_hem_2" }, { "at": 0, "do": "hide", "on": "ghost_hem_1" }, { "at": 0, "do": "hide", "on": "ghost_arm_l" }, { "at": 0, "do": "hide", "on": "tv_can_a" }, { "at": 0, "do": "hide", "on": "tv_can_b" }
  ]
