      { "do": "pose", "on": "$who", "bones": { "head": [4, 0, -19], "neck": [0, 0, -6], "chest": [7, 0, -3] }, "for": "0.8b", "ease": "inout", "overshoot": 0.12, "settle": "0.4s" },
      { "at": "+2.2b", "do": "pose", "on": "$who", "bones": { "head": [0, 0, 0], "neck": [0, 0, 0], "chest": [0, 0, 0] }, "for": "0.8b", "ease": "inout" }
    ],
    // The hand around the remote: four fingers wrapped under it, each a little tighter toward the little finger, thumb on top.
    "grip": [
      { "do": "fingers", "on": "$who", "hand": "left", "finger": "index", "curl": 0.62, "for": "0.3b", "ease": "out" },
      { "do": "fingers", "on": "$who", "hand": "left", "finger": "middle", "curl": 0.68, "for": "0.3b", "ease": "out" },
      { "do": "fingers", "on": "$who", "hand": "left", "finger": "ring", "curl": 0.72, "for": "0.3b", "ease": "out" },
      { "do": "fingers", "on": "$who", "hand": "left", "finger": "pinky", "curl": 0.76, "for": "0.3b", "ease": "out" },
      { "do": "fingers", "on": "$who", "hand": "left", "finger": "thumb", "curl": 0.3, "for": "0.3b", "ease": "out" }
    ],
    "hello": [
      { "do": "layer", "on": "$who", "clip": "IdleSit13GreetA", "mask": "rightArm,spine", "start": 0.3, "speed": 0.5, "stop": 1.62, "once": 1, "for": "3.6b", "blend": "0.4b" }
    ],
    "hello2": [
      { "do": "layer", "on": "$who", "clip": "IdleSit13GreetA", "mask": "rightArm,spine", "start": 0.35, "speed": 0.9, "stop": 1.62, "once": 1, "for": "2.3b", "blend": "0.25s" }
    ],
    "jab": [
      { "do": "fingers", "on": "person", "hand": "left", "finger": "thumb", "curl": 0.5, "for": "0.08b", "ease": "out", "sfx": "$snd" },
      { "do": "pose", "on": "person", "bones": { "leftHand": [18, 0, 0], "leftUpperArm": ["$a", 0, 0] }, "for": "0.07b", "ease": "out" },
      { "at": "+0.09b", "do": "fingers", "on": "person", "hand": "left", "finger": "thumb", "curl": 0.3, "for": "0.25b", "ease": "out" },
      { "at": "+0.09b", "do": "pose", "on": "person", "bones": { "leftHand": [0, 0, 0], "leftUpperArm": [0, 0, 0] }, "for": "0.22b", "ease": "out" }
    ],
    "tick": [
      { "do": "rotate", "on": "p1_frame", "rot": [0, 0, "$z"], "for": "0.1b", "ease": "back", "sfx": "frame_tick" },
      { "do": "rotate", "on": "p1_pic", "rot": [0, 0, "$z"], "for": "0.1b", "ease": "back" }
    ]
  }
}
