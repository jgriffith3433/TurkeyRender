{
  // The cameraman (STORYBOARD): he turns to the corner, it turns to him, and behind it, in the dark, the tie bird is filming.
  // Three walls: he sees the camera, the camera films the cameraman, the cameraman sees you.
  // A set far from everything, at x=-200, lit by the monitor. Cold blue; the tie is the only red.
  // There is one feed camera in the film, so tv1's picture is borrowed: tv1 is off screen for the whole beat, the monitor shares its feed, and tv1 gets p1_self back on the cut out.
  "shows": {
    // The corner camera, tight on him: what the lens sees.
    "p1b_corner": { "set": "p1b_set", "pos": [202.2, 2.7, 2.15], "rot": [23, 216, 0], "fov": 15 },
    // Behind the bird. Shot 3 is this same view on the main camera at the crop that fills the frame, so the push ends in a match cut.
    "p1b_behind": { "set": "p1b_set", "pos": [0.05, 1.5, -2.05], "rot": [3.4, 0, 0], "fov": 34 }
  },
  "actors": {
    "p1b_set": { "model": "none", "pos": [-200, 0, 0] },
    "p1b_floor": { "model": "prim:cube", "pos": [-200, -0.05, 0.5], "scale": [40, 0.1, 40], "color": "#030405", "smooth": 0.15, "from": "11:1", "until": "13:2" },

    "p1b_bird": { "model": "turkey_white_hero", "pos": [-200.28, 0, 0], "rot": [0, 8, 0], "scale": 2.2, "from": "11:1", "until": "13:2" },
    "p1b_tie": { "model": "Assets/MusicVideo/Props/tie.obj", "material": "Assets/MusicVideo/Props/tie.mat", "scale": 0.36, "from": "11:1", "until": "13:2" },

    // Headphones, on the head so they turn with it.
    "p1b_cupL": { "model": "prim:sphere", "parent": "p1b_bird.head", "pos": [-0.021, 0.008, 0], "scale": [0.04, 0.09, 0.09], "color": "#2a3038", "smooth": 0.7, "from": "11:1", "until": "13:2" },
    "p1b_cupR": { "model": "prim:sphere", "parent": "p1b_bird.head", "pos": [0.021, 0.008, 0], "scale": [0.04, 0.09, 0.09], "color": "#2a3038", "smooth": 0.7, "from": "11:1", "until": "13:2" },
    "p1b_bandT": { "model": "prim:cube", "parent": "p1b_bird.head", "pos": [0, 0.028, 0], "scale": [0.09, 0.012, 0.025], "color": "#2a3038", "smooth": 0.7, "from": "11:1", "until": "13:2" },
    "p1b_bandL": { "model": "prim:cube", "parent": "p1b_bird.head", "pos": [-0.017, 0.022, 0], "rot": [0, 0, -55], "scale": [0.05, 0.012, 0.025], "color": "#2a3038", "smooth": 0.7, "from": "11:1", "until": "13:2" },
    "p1b_bandR": { "model": "prim:cube", "parent": "p1b_bird.head", "pos": [0.017, 0.022, 0], "rot": [0, 0, 55], "scale": [0.05, 0.012, 0.025], "color": "#2a3038", "smooth": 0.7, "from": "11:1", "until": "13:2" },

    // The studio camera, a big pedestal one, lens away from us into the dark.
    "p1b_cam": { "model": "prim:cube", "pos": [-200.92, 1.32, 0.78], "scale": [0.36, 0.42, 0.78], "color": "#14171c", "smooth": 0.5, "from": "11:1", "until": "13:2" },
    "p1b_hood": { "model": "prim:cube", "pos": [-200.92, 1.32, 1.3], "scale": [0.42, 0.36, 0.3], "color": "#0d0f13", "smooth": 0.4, "from": "11:1", "until": "13:2" },
    "p1b_vf": { "model": "prim:cube", "pos": [-200.92, 1.64, 0.5], "scale": [0.3, 0.22, 0.3], "color": "#14171c", "smooth": 0.5, "from": "11:1", "until": "13:2" },
    "p1b_vfglow": { "model": "prim:cube", "pos": [-200.92, 1.64, 0.345], "scale": [0.24, 0.16, 0.01], "color": "#000000", "emission": "#06101a", "from": "11:1", "until": "13:2" },
    "p1b_ped": { "model": "prim:cylinder", "pos": [-200.92, 0.56, 0.78], "scale": [0.13, 0.56, 0.13], "color": "#101318", "smooth": 0.5, "from": "11:1", "until": "13:2" },
    "p1b_base": { "model": "prim:cylinder", "pos": [-200.92, 0.07, 0.78], "scale": [0.46, 0.07, 0.46], "color": "#0d0f13", "smooth": 0.3, "from": "11:1", "until": "13:2" },
    "p1b_arm": { "model": "prim:cube", "pos": [-200.67, 1.17, 0.26], "rot": [0, -38, 0], "scale": [0.03, 0.03, 0.62], "color": "#1a1d22", "smooth": 0.6, "from": "11:1", "until": "13:2" },

    // The monitor, on a stand beside it. Its glass is the only real light in the set.
    "p1b_mon": { "model": "none", "pos": [-199.62, 1.36, 0.76], "from": "11:1", "until": "13:2",
      "tv": { "share": "tv1", "size": [0.62, 0.465], "screenPos": [0, 0, 0], "spill": 5, "glow": 1.1, "glowRange": 4, "range": 7, "angle": 150, "suck": false } },
    "p1b_bezel": { "model": "prim:cube", "pos": [-199.62, 1.36, 0.83], "scale": [0.7, 0.545, 0.13], "color": "#0e1014", "smooth": 0.5, "from": "11:1", "until": "13:2" },
    "p1b_stand": { "model": "prim:cylinder", "pos": [-199.62, 0.55, 0.83], "scale": [0.04, 0.55, 0.04], "color": "#101318", "from": "11:1", "until": "13:2" },
    "p1b_foot": { "model": "prim:cylinder", "pos": [-199.62, 0.03, 0.83], "scale": [0.3, 0.03, 0.3], "color": "#0d0f13", "from": "11:1", "until": "13:2" }
  },
  "lights": {
    // Enough on his back to read the shape: the monitor does the rest.
    "p1b_rim": { "type": "point", "pos": [-200.1, 2.5, -1.1], "color": "#4f7fd0", "intensity": 0, "range": 4.5 },
    // The stare: the face comes round into the only other light there is.
    "p1b_face": { "type": "point", "pos": [-200.2, 1.75, -0.75], "color": "#9cc4ff", "intensity": 0, "range": 2.2 }
  },
  "cues": [
    { "at": "11:3.4", "light": "p1b_rim", "intensity": 0.5, "for": "0.02b" },
    { "at": "12:4.46", "light": "p1b_rim", "intensity": 0, "for": "0.02b" },
    { "at": "12:4.46", "light": "p1b_face", "intensity": 0, "for": "0.02b" },

    { "at": 0, "do": "anim", "on": "p1b_bird", "clip": "idle", "speed": 0.35, "for": "30bars" },
    { "at": 0, "do": "attach", "on": "p1b_tie", "to": "p1b_bird.neck3", "pos": [0, 0.015, 0.03], "rot": [0, 0, 0] },

    // Fan folded down, a wing out to the camera's handle.
    { "at": 0, "do": "pose", "on": "p1b_bird", "bone": "tail", "rot": [-80, 0, 0], "for": "0.1s" },
    { "at": 0, "do": "pose", "on": "p1b_bird", "bones": { "arm_L": [0, 0, 35], "forearm_L": [0, 25, 0] }, "for": "0.1s" },

    // ---- 3. The turn. Nothing else moves. It holds on us until the cut.
    // Quick and early, so it lands on the lens with half a second left to stare: head leads, one small overshoot, dead still.
    { "at": "12:1.47", "do": "keys", "on": "p1b_bird", "successive": 0.05, "overshoot": 0.06, "settle": "0.25s", "keys": [
      { "t": "0.15b", "bones": { "head": [0, -6, 0] } },
      { "t": "0.8b", "ease": "inout", "bones": { "neck1": [0, 30, 0], "neck2": [0, 45, 0], "neck3": [0, 45, 0], "neck4": [0, 20, 0], "head": [12, 38, 0] } }
    ] },
    { "at": "12:1.47", "light": "p1b_face", "intensity": 0.5, "for": "0.8b", "ease": "in" },

    // ---- The monitor. tv1's feed: the corner view until the push, then the bird from behind, the monitor inside itself.
    { "at": 0, "tv": "p1b_mon", "bright": 0, "static": 0, "feed": 1, "tint": "#d8ecff" },
    { "at": "11:3.4", "tv": "p1b_mon", "bright": 1.4, "feed": 1, "static": 0, "for": "0.02b" },
    { "at": "11:3.42", "tv": "tv1", "show": "p1b_corner" },
    { "at": "11:4.46", "tv": "tv1", "show": "p1b_behind" },
    { "at": "11:4.46", "tv": "p1b_mon", "static": 0.8, "for": "0.02b" },
    { "at": "11:4.5", "tv": "p1b_mon", "static": 0, "for": "0.25b", "sfx": "static_burst", "sfxVolume": 0.5 },
    { "at": "12:4.46", "tv": "tv1", "show": "p1_self" },

    // He keeps staring into the lens while the monitor still shows him (02 sends him back to the TV at 11:4.47).
    { "at": "11:4.48", "do": "gaze", "on": "person", "to": "cctv", "for": "0.1b" },
    { "at": "12:1.46", "do": "gaze", "on": "person", "to": "tv1.screen", "for": "0.9b", "ease": "out" },

    // ---- 1 and 2. Behind him in the dark, the monitor has the man on the sofa, looking in. One move: it creeps, then falls into the glass.
    { "at": "11:3.46", "shot": { "name": "the cameraman", "pos": [-200.0, 1.56, -2.3], "move": [-199.62, 1.36, 0.11], "rot": [6.1, -3.9, 0], "rotate": [0, 0, 0], "fov": 36, "fovTo": 30, "fovFor": "2.01b", "fovEase": "in", "ease": "in", "focus": "p1b_mon", "aperture": 8 } },
    // ---- 3. The push lands on the monitor's own view, full frame: p1b_behind at the crop that fills 16:9. The bird turns its head and stares at you.
    { "at": "12:1.47", "shot": { "name": "the stare", "pos": [-199.95, 1.5, -2.05], "move": [-200.1, 1.42, -1.1], "rot": [3.4, 0, 0], "rotate": [13, 0, 0], "ease": "inout", "fov": 26.1, "focus": "p1b_bird.head", "aperture": 8 } }
  ]
}
