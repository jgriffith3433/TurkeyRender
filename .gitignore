# Generated and bulky Director files
/Director/output/
/Director/captures/
/Director/stems/
/Director/ai_footage/
/Director/acts_ai/
/Director/acts_v1/
/Director/review/sheets/
/Director/assets/previews/
/Director/gen/
/Director/staging/
